  <tool name="asset_builder_template" label="Asset Builder Template" icon="hicon:/SVGIcons.index?BUTTONS_addasset.svg">
    <script scriptType="python"><![CDATA[import hou
import os

path = hou.expandString("$CUSTOM_TOOLS/templates/Asset_Builder_Template.hiplc")
pattern = "*component* *material* *domelight*"

if not os.path.isfile(path):
    hou.ui.displayMessage(
        f"Template not found:\n{path}\n\nCheck that CUSTOM_TOOLS points at your custom_tools folder.",
        severity=hou.severityType.Error,
        title="Asset Builder Template",
    )
else:
    try:
        hou.hipFile.merge(path, pattern, False, True)
    except Exception as exc:
        hou.ui.displayMessage(
            f"Failed to merge Asset Builder Template:\n{exc}",
            severity=hou.severityType.Error,
            title="Asset Builder Template",
        )]]></script>
  </tool>

